---
const phone = "5547988041306";
const msg = encodeURIComponent("Olá! Vi o site e preciso de um orçamento para um reparo em Blumenau.");
const waUrl = `https://wa.me/${phone}?text=${msg}`;
---
<header class="fixed top-4 left-0 right-0 z-50 px-4 sm:px-6">
  <div 
    id="main-header-container"
    class="relative mx-auto w-full max-w-6xl bg-surface-1/95 backdrop-blur-md transition-[max-height,border-radius,background-color] duration-500 ease-in-out max-h-16 overflow-hidden rounded-2xl border border-border-main shadow-soft"
  >
    <!-- Top Bar -->
    <div class="flex h-16 w-full items-center justify-between gap-4 px-4 sm:px-6">
      <!-- Logo -->
      <div class="flex items-center shrink-0">
        <a href="/" class="flex items-center no-underline">
          <picture>
            <source srcset="/images/logo-fix.webp" type="image/webp" />
            <img 
              src="/images/logo-fix.png" 
              alt="Fix Serviços" 
              width="147"
              height="32"
              loading="eager"
              decoding="async"
              class="h-7 sm:h-8 w-auto"
            />
          </picture>
        </a>
      </div>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex flex-1 items-center justify-center gap-1">
        <a href="/eletricista/" class="px-4 py-2 text-sm font-semibold tracking-tight text-text-nav hover:text-brand-green transition-colors no-underline">Eletricista</a>
        <a href="/encanador/" class="px-4 py-2 text-sm font-semibold tracking-tight text-text-nav hover:text-brand-green transition-colors no-underline">Encanador</a>
        <a href="/marido-de-aluguel/" class="px-4 py-2 text-sm font-semibold tracking-tight text-text-nav hover:text-brand-green transition-colors no-underline">Marido de Aluguel</a>
        <a href="/casa-inteligente/" class="px-4 py-2 text-sm font-semibold tracking-tight text-text-nav hover:text-brand-green transition-colors no-underline">Casa Inteligente</a>
      </nav>

      <!-- Right Side Actions -->
      <div class="flex items-center gap-2 sm:gap-4 shrink-0">
        <!-- Theme Toggle -->
        <button 
          id="theme-toggle-btn"
          class="flex items-center justify-center p-2 text-text-muted hover:text-brand-green transition-all group"
          aria-label="Alternar tema"
        >
          <svg id="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-moon hidden group-hover:text-brand-green"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"></path></svg>
          <svg id="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sun hidden group-hover:text-brand-green"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
        </button>

        <!-- Desktop CTA -->
        <div class="hidden lg:flex">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-brand-green hover:bg-brand-green-hover text-white px-6 py-2.5 rounded-xl text-xs font-bold uppercase tracking-widest transition-all no-underline shadow-lg shadow-brand-green/20"
          >
            Solicitar Orçamento
          </a>
        </div>

        <!-- Mobile Toggle Button -->
        <button 
          id="menu-toggle-btn" 
          class="lg:hidden flex items-center justify-center size-10 rounded-xl border border-border-main bg-surface-2 text-text-main transition-colors hover:bg-surface-1"
          aria-label="Toggle menu"
        >
          <svg id="icon-menu" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>
          <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x hidden"><line x1="18" x2="6" y1="6" y2="18"></line><line x1="6" x2="18" y1="6" y2="18"></line></svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Content -->
    <div id="mobile-nav-content" class="lg:hidden bg-surface-1 border-t border-border-main flex flex-col">
      <div class="flex flex-col">
        <a href="/eletricista/" class="flex items-center justify-between px-6 py-5 border-b border-surface-2 no-underline group">
          <span class="text-lg font-semibold text-text-nav font-display group-hover:text-brand-green transition-colors">Eletricista</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-navy"><path d="m9 18 6-6-6-6"></path></svg>
        </a>
        <a href="/encanador/" class="flex items-center justify-between px-6 py-5 border-b border-surface-2 no-underline group">
          <span class="text-lg font-semibold text-text-nav font-display group-hover:text-brand-green transition-colors">Encanador</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-navy"><path d="m9 18 6-6-6-6"></path></svg>
        </a>
        <a href="/marido-de-aluguel/" class="flex items-center justify-between px-6 py-5 border-b border-surface-2 no-underline group">
          <span class="text-lg font-semibold text-text-nav font-display group-hover:text-brand-green transition-colors">Marido de Aluguel</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-navy"><path d="m9 18 6-6-6-6"></path></svg>
        </a>
        <a href="/casa-inteligente/" class="flex items-center justify-between px-6 py-5 border-b border-surface-2 no-underline group">
          <span class="text-lg font-semibold text-text-nav font-display group-hover:text-brand-green transition-colors">Casa Inteligente</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-navy"><path d="m9 18 6-6-6-6"></path></svg>
        </a>
      </div>
      <div class="p-6 bg-surface-2">
        <a 
          href={waUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="block text-center bg-brand-green text-white py-5 rounded-2xl font-bold uppercase tracking-widest no-underline shadow-xl shadow-brand-green/20"
        >
          Solicitar Orçamento
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const getTheme = () => {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme');
    }
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  };

  const applyTheme = (theme) => {
    document.documentElement.setAttribute('data-theme', theme);
    if (theme === 'dark') {
      document.getElementById('theme-icon-sun')?.classList.remove('hidden');
      document.getElementById('theme-icon-moon')?.classList.add('hidden');
    } else {
      document.getElementById('theme-icon-sun')?.classList.add('hidden');
      document.getElementById('theme-icon-moon')?.classList.remove('hidden');
    }
    localStorage.setItem('theme', theme);
  };

  applyTheme(getTheme());

  const themeBtn = document.getElementById('theme-toggle-btn');
  themeBtn?.addEventListener('click', (event) => {
    const currentTheme = document.documentElement.getAttribute('data-theme');
    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';

    if (!document.startViewTransition) {
      applyTheme(newTheme);
      return;
    }

    const x = event.clientX;
    const y = event.clientY;
    const endRadius = Math.hypot(
      Math.max(x, innerWidth - x),
      Math.max(y, innerHeight - y)
    );

    const transition = document.startViewTransition(() => {
      applyTheme(newTheme);
    });

    transition.ready.then(() => {
      document.documentElement.animate(
        {
          clipPath: [
            `circle(0px at ${x}px ${y}px)`,
            `circle(${endRadius}px at ${x}px ${y}px)`,
          ],
        },
        {
          duration: 500,
          easing: 'ease-in-out',
          pseudoElement: '::view-transition-new(root)',
        }
      );
    });
  });

  const headerContainer = document.getElementById('main-header-container');
  const menuToggleBtn = document.getElementById('menu-toggle-btn');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');
  
  let isMenuOpen = false;

  menuToggleBtn?.addEventListener('click', () => {
    isMenuOpen = !isMenuOpen;
    if (isMenuOpen) {
      headerContainer?.classList.replace('max-h-16', 'max-h-[500px]');
      iconMenu?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    } else {
      headerContainer?.classList.replace('max-h-[500px]', 'max-h-16');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    }
  });
</script>
