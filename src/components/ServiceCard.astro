---
interface Props {
  href: string;
  titulo: string;
  descricao: string;
  icone: string; // SVG path(s) as string
  viewBox?: string;
  filled?: boolean;
}

const { href, titulo, descricao, icone, viewBox = "0 0 24 24", filled = false } = Astro.props;
---

<a
  href={href}
  class="group relative flex items-center gap-4 p-5 bg-white dark:bg-surface-1 rounded-2xl border border-border-main hover:border-brand-green/40 shadow-sm hover:shadow-lg hover:shadow-brand-green/5 transition-all duration-300 no-underline hover:-translate-y-0.5"
>
  <!-- Icon bubble -->
  <div class="flex-none flex items-center justify-center w-12 h-12 rounded-xl bg-brand-green/8 text-brand-green group-hover:bg-brand-green group-hover:text-white transition-all duration-300 shrink-0">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="22"
      height="22"
      viewBox={viewBox}
      fill={filled ? "currentColor" : "none"}
      stroke={filled ? "none" : "currentColor"}
      stroke-width={filled ? "0" : "1.8"}
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={icone}
    />
  </div>

  <!-- Text -->
  <div class="flex-1 min-w-0">
    <h3 class="text-base font-bold text-text-main group-hover:text-brand-green transition-colors leading-snug">
      {titulo}
    </h3>
    <p class="text-sm text-text-muted mt-0.5 leading-relaxed">
      {descricao}
    </p>
  </div>

  <!-- Chevron -->
  <div class="flex-none text-brand-green/40 group-hover:text-brand-green group-hover:translate-x-1 transition-all duration-300">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m9 18 6-6-6-6"/>
    </svg>
  </div>
</a>
