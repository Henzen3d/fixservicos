<style>
  .marquee-track {
    animation: marquee 50s linear infinite;
    will-change: transform;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }

  @media (max-width: 640px) {
    .marquee-track {
      animation-duration: 35s;
    }
  }
</style>
