---
import { FIX_REVIEWS_URL } from '../data/business';
import { GOOGLE_REVIEWS } from '../data/reviews';

const accentClasses = {
  green: 'bg-brand-green/10 text-brand-green border-brand-green/20 group-hover:bg-brand-green group-hover:text-white',
  blue: 'bg-blue-500/10 text-blue-400 border-blue-500/20 group-hover:bg-blue-500 group-hover:text-white',
  purple: 'bg-purple-500/10 text-purple-400 border-purple-500/20 group-hover:bg-purple-500 group-hover:text-white',
  orange: 'bg-orange-500/10 text-orange-400 border-orange-500/20 group-hover:bg-orange-500 group-hover:text-white',
} as const;

const initialReviews = GOOGLE_REVIEWS.slice(0, 4);
const batches = Array.from({ length: Math.max(1, Math.ceil(GOOGLE_REVIEWS.length / 4)) });
---
<section id="reviews" class="bg-brand-navy dark:bg-[#050B14] py-24 sm:py-32 overflow-hidden relative transition-colors duration-500">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <div class="inline-flex items-center bg-brand-green/10 text-brand-green px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide mb-4 border border-brand-green/20">
          Depoimentos
        </div>
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-5xl font-display">
          O que dizem nossos clientes em <span class="text-brand-green italic font-medium">Blumenau</span>.
        </h2>
        <p class="mt-8 text-lg text-white/70 leading-relaxed max-w-xl">
          A satisfação de quem já utilizou nossos serviços é a nossa maior garantia. Atuamos com transparência e respeito em cada residência que entramos.
        </p>

        <div class="mt-10 space-y-6">
          <a
            href={FIX_REVIEWS_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-brand-green/10 border border-brand-green/20 text-white/90 font-medium group hover:scale-105 transition-transform cursor-pointer no-underline"
          >
            <!-- Google Logo SVG -->
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="20px" height="20px" class="flex-shrink-0" aria-hidden="true">
              <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
              <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
              <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
              <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
              <path fill="none" d="M0 0h48v48H0z"/>
            </svg>
            <span>Média 5 estrelas no <strong class="font-bold">Google</strong></span>
          </a>

          {[
            "Referência em rapidez e limpeza na cidade",
            "Garantia estendida em todos os serviços"
          ].map((item) => (
            <div class="flex items-center gap-4 text-white/90 font-medium group">
              <div class="flex-shrink-0 h-6 w-6 rounded-full bg-brand-green/10 flex items-center justify-center border border-brand-green/20 group-hover:scale-110 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check text-brand-green" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              </div>
              {item}
            </div>
          ))}
        </div>
      </div>

      <div>
        <div
          id="reviews-grid"
          class="grid grid-cols-1 gap-6 sm:grid-cols-2"
          data-reviews={JSON.stringify(GOOGLE_REVIEWS)}
        >
          {initialReviews.map((review, index) => (
            <a
              href={review.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-review-card
              aria-label={`Ver avaliação de ${review.author} no Google (abre em nova aba)`}
              class:list={[
                "bg-brand-navy-mid/40 dark:bg-white/5 backdrop-blur-md border border-white/10 p-6 rounded-2xl transition-all duration-300 hover:border-brand-green/50 hover:translate-y-[-4px] motion-reduce:hover:translate-y-0 shadow-lg group flex flex-col justify-between min-h-[230px] no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-green",
                index % 2 === 1 ? "sm:mt-12" : ""
              ]}
            >
              <div>
                <div class="flex items-center justify-between gap-2 mb-4">
                  <div class="flex gap-1 text-yellow-500 items-center" aria-label="Avaliação 5 de 5 estrelas">
                    {[1, 2, 3, 4, 5].map(() => (
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star fill-yellow-500 text-yellow-500" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path></svg>
                    ))}
                  </div>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/35 group-hover:text-brand-green transition-colors shrink-0" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                </div>
                <p data-review-text class="text-white/90 italic mb-6 leading-relaxed">
                  &ldquo;{review.text}&rdquo;
                </p>
              </div>

              <div class="flex items-center gap-3">
                <div
                  data-review-avatar
                  class={`h-10 w-10 rounded-full flex items-center justify-center font-bold border transition-colors shrink-0 ${accentClasses[review.accent]}`}
                >
                  {review.initial}
                </div>
                <div class="min-w-0">
                  <p data-review-author class="text-white font-bold text-sm truncate">{review.author}</p>
                  <p data-review-tag class="text-white/70 text-[10px] uppercase tracking-widest font-bold truncate">{review.tag}</p>
                </div>
              </div>
            </a>
          ))}
        </div>

        <!-- Subtle dynamic rotation controls -->
        <div class="mt-8 flex items-center justify-between gap-4">
          <div id="reviews-dots" class="flex items-center gap-2" role="tablist" aria-label="Selecionar grupo de avaliações">
            {batches.map((_, idx) => (
              <button
                type="button"
                data-review-dot={idx}
                aria-label={`Mostrar conjunto ${idx + 1} de avaliações`}
                aria-selected={idx === 0 ? 'true' : 'false'}
                class:list={[
                  "h-2 rounded-full transition-all duration-300 cursor-pointer",
                  idx === 0 ? "w-6 bg-brand-green" : "w-2 bg-white/25 hover:bg-white/45"
                ]}
              ></button>
            ))}
          </div>

          <div class="flex items-center gap-2">
            <button
              type="button"
              id="reviews-prev"
              aria-label="Avaliações anteriores"
              class="h-9 w-9 rounded-full border border-white/15 bg-white/5 text-white/80 hover:text-white hover:border-brand-green/50 flex items-center justify-center transition-colors cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <button
              type="button"
              id="reviews-next"
              aria-label="Próximas avaliações"
              class="h-9 w-9 rounded-full border border-white/15 bg-white/5 text-white/80 hover:text-white hover:border-brand-green/50 flex items-center justify-center transition-colors cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Ambient Glows - Differentiated by theme -->
  <div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/2 h-96 w-96 rounded-full bg-brand-green/10 blur-[120px] dark:bg-brand-green/20 dark:blur-[150px] transition-all duration-700"></div>
  <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 h-96 w-96 rounded-full bg-blue-500/10 blur-[120px] dark:bg-purple-500/15 dark:blur-[150px] transition-all duration-700"></div>
</section>

<script is:inline>
  (function () {
    const section = document.getElementById('reviews');
    const grid = document.getElementById('reviews-grid');
    if (!section || !grid) return;

    let reviews = [];
    try {
      reviews = JSON.parse(grid.getAttribute('data-reviews') || '[]');
    } catch {
      return;
    }
    if (!Array.isArray(reviews) || reviews.length <= 4) return;

    const cards = Array.from(grid.querySelectorAll('[data-review-card]'));
    const dots = Array.from(section.querySelectorAll('[data-review-dot]'));
    const prevBtn = document.getElementById('reviews-prev');
    const nextBtn = document.getElementById('reviews-next');

    const accentMap = {
      green: 'h-10 w-10 rounded-full flex items-center justify-center font-bold border transition-colors shrink-0 bg-brand-green/10 text-brand-green border-brand-green/20 group-hover:bg-brand-green group-hover:text-white',
      blue: 'h-10 w-10 rounded-full flex items-center justify-center font-bold border transition-colors shrink-0 bg-blue-500/10 text-blue-400 border-blue-500/20 group-hover:bg-blue-500 group-hover:text-white',
      purple: 'h-10 w-10 rounded-full flex items-center justify-center font-bold border transition-colors shrink-0 bg-purple-500/10 text-purple-400 border-purple-500/20 group-hover:bg-purple-500 group-hover:text-white',
      orange: 'h-10 w-10 rounded-full flex items-center justify-center font-bold border transition-colors shrink-0 bg-orange-500/10 text-orange-400 border-orange-500/20 group-hover:bg-orange-500 group-hover:text-white',
    };

    const stride = reviews.length >= 8 ? 4 : 3;
    const totalSets = reviews.length >= 8 ? Math.ceil(reviews.length / stride) : reviews.length;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let currentSet = 0;
    let isVisible = false;
    let isPaused = false;
    let timerId = null;
    let lastScrollBucket = -1;
    let lastSwitchAt = 0;

    function renderSet(nextSet, animate = true) {
      const normalized = ((nextSet % totalSets) + totalSets) % totalSets;
      if (normalized === currentSet) return;
      currentSet = normalized;

      const applyContent = () => {
        const start = (currentSet * stride) % reviews.length;
        cards.forEach((card, idx) => {
          const item = reviews[(start + idx) % reviews.length];
          const textEl = card.querySelector('[data-review-text]');
          const authorEl = card.querySelector('[data-review-author]');
          const tagEl = card.querySelector('[data-review-tag]');
          const avatarEl = card.querySelector('[data-review-avatar]');

          card.setAttribute('href', item.sourceUrl);
          card.setAttribute('aria-label', `Ver avaliação de ${item.author} no Google (abre em nova aba)`);
          if (textEl) textEl.textContent = `\u201C${item.text}\u201D`;
          if (authorEl) authorEl.textContent = item.author;
          if (tagEl) tagEl.textContent = item.tag;
          if (avatarEl) {
            avatarEl.textContent = item.initial;
            avatarEl.className = accentMap[item.accent] || accentMap.green;
          }
        });

        dots.forEach((dot, idx) => {
          const active = idx === currentSet;
          dot.setAttribute('aria-selected', active ? 'true' : 'false');
          dot.className = active
            ? 'h-2 rounded-full transition-all duration-300 cursor-pointer w-6 bg-brand-green'
            : 'h-2 rounded-full transition-all duration-300 cursor-pointer w-2 bg-white/25 hover:bg-white/45';
        });
      };

      if (!animate || prefersReducedMotion) {
        applyContent();
        return;
      }

      grid.style.opacity = '0.35';
      grid.style.transform = 'translateY(4px)';
      setTimeout(() => {
        applyContent();
        grid.style.opacity = '1';
        grid.style.transform = 'translateY(0)';
      }, 180);
    }

    grid.style.transition = prefersReducedMotion ? 'none' : 'opacity 220ms ease, transform 220ms ease';

    function startTimer() {
      if (prefersReducedMotion || timerId) return;
      timerId = setInterval(() => {
        if (isVisible && !isPaused) {
          renderSet(currentSet + 1, true);
          lastSwitchAt = Date.now();
        }
      }, 6500);
    }

    function stopTimer() {
      if (timerId) {
        clearInterval(timerId);
        timerId = null;
      }
    }

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          isVisible = entries[0].isIntersecting;
          if (isVisible) startTimer();
          else stopTimer();
        },
        { threshold: 0.25 }
      );
      observer.observe(section);
    }

    let scrollTicking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (prefersReducedMotion || window.innerWidth < 1024 || isPaused || scrollTicking) return;
        scrollTicking = true;
        requestAnimationFrame(() => {
          scrollTicking = false;
          const rect = section.getBoundingClientRect();
          const vh = window.innerHeight || 800;
          if (rect.bottom <= 0 || rect.top >= vh) return;

          const progress = Math.min(1, Math.max(0, (vh - rect.top) / (vh + rect.height)));
          const bucket = Math.floor(progress * 3);
          if (lastScrollBucket !== -1 && bucket !== lastScrollBucket && Date.now() - lastSwitchAt > 1100) {
            const delta = bucket > lastScrollBucket ? 1 : -1;
            renderSet(currentSet + delta, true);
            lastSwitchAt = Date.now();
          }
          lastScrollBucket = bucket;
        });
      },
      { passive: true }
    );

    prevBtn?.addEventListener('click', () => {
      renderSet(currentSet - 1, true);
      lastSwitchAt = Date.now();
    });

    nextBtn?.addEventListener('click', () => {
      renderSet(currentSet + 1, true);
      lastSwitchAt = Date.now();
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = Number(dot.getAttribute('data-review-dot'));
        if (!Number.isNaN(idx)) {
          renderSet(idx, true);
          lastSwitchAt = Date.now();
        }
      });
    });

    section.addEventListener('mouseenter', () => { isPaused = true; });
    section.addEventListener('mouseleave', () => { isPaused = false; });
    section.addEventListener('focusin', () => { isPaused = true; });
    section.addEventListener('focusout', () => { isPaused = false; });
  })();
</script>
