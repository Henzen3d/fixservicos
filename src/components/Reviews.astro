---
import { FIX_REVIEWS_URL, FIX_TECHNICIAN } from '../data/business';

const commitments = [
  {
    badge: "RT",
    badgeClass: "bg-brand-green/10 text-brand-green border-brand-green/20 group-hover:bg-brand-green group-hover:text-white",
    title: FIX_TECHNICIAN.displayName,
    subtitle: "Técnico em Edificações (SENAI) · NR10 e NR35",
    desc: "Atendimento realizado diretamente pelo técnico responsável em residências e empresas de Blumenau, com ferramentas adequadas e acabamento limpo.",
  },
  {
    badge: "OR",
    badgeClass: "bg-blue-500/10 text-blue-400 border-blue-500/20 group-hover:bg-blue-500 group-hover:text-white",
    title: "Orçamento claro pelo WhatsApp",
    subtitle: "Envie modelo, foto e bairro",
    desc: "Avaliamos previamente o escopo, o tipo de parede ou circuito e informamos o que está incluso e eventuais variáveis antes de agendar a visita.",
  },
  {
    badge: "AG",
    badgeClass: "bg-purple-500/10 text-purple-400 border-purple-500/20 group-hover:bg-purple-500 group-hover:text-white",
    title: "Atendimento de segunda a sexta",
    subtitle: "08h às 18h · Sábado e domingo fechado",
    desc: "Agenda organizada por região em Blumenau (Velha, Velha Central, Centro e demais bairros) para cumprir o horário combinado.",
  },
  {
    badge: "NF",
    badgeClass: "bg-orange-500/10 text-orange-400 border-orange-500/20 group-hover:bg-orange-500 group-hover:text-white",
    title: "Nota fiscal e garantia informada",
    subtitle: "NFS-e e termo específico por serviço",
    desc: "Emitimos NFS-e e informamos no próprio orçamento o prazo de garantia aplicável ao serviço executado e aos materiais envolvidos.",
  },
];
---
<section id="reviews" class="bg-brand-navy dark:bg-[#050B14] py-24 sm:py-32 overflow-hidden relative transition-colors duration-500">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <div class="inline-flex items-center bg-brand-green/10 text-brand-green px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide mb-4 border border-brand-green/20">
          Reputação e transparência
        </div>
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-5xl font-display">
          Avaliações reais de clientes em <span class="text-brand-green italic font-medium">Blumenau</span>.
        </h2>
        <p class="mt-8 text-lg text-white/70 leading-relaxed max-w-xl">
          As opiniões dos clientes atendidos pela Fix Serviços ficam públicas diretamente no Google Maps, onde você pode consultar comentários reais antes de contratar.
        </p>

        <div class="mt-10 space-y-6">
          <div class="flex flex-wrap items-center gap-3">
            <a
              href={FIX_REVIEWS_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-3 px-4 py-2.5 rounded-full bg-brand-green/10 border border-brand-green/20 text-white/90 font-medium group hover:scale-105 transition-transform cursor-pointer no-underline"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="20px" height="20px" class="flex-shrink-0" aria-hidden="true">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                <path fill="none" d="M0 0h48v48H0z"/>
              </svg>
              <span>Ler avaliações no <strong class="font-bold">Google</strong></span>
            </a>

            <a
              href="/avaliar/"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-white/5 border border-white/15 text-white/80 hover:text-white hover:border-brand-green/40 text-sm font-medium transition-colors no-underline"
            >
              Avaliar meu atendimento
            </a>
          </div>

          {[
            "Atendimento em domicílio em Blumenau (Seg–Sex, 08h às 18h)",
            "Emissão de nota fiscal (NFS-e) e garantia informada no orçamento"
          ].map((item) => (
            <div class="flex items-center gap-4 text-white/90 font-medium group">
              <div class="flex-shrink-0 h-6 w-6 rounded-full bg-brand-green/10 flex items-center justify-center border border-brand-green/20 group-hover:scale-110 transition-transform">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check text-brand-green" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              </div>
              {item}
            </div>
          ))}
        </div>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {commitments.map((card, index) => (
          <div class:list={[
            "bg-brand-navy-mid/40 dark:bg-white/5 backdrop-blur-md border border-white/10 p-6 rounded-2xl transition-all duration-300 hover:border-brand-green/50 hover:translate-y-[-4px] motion-reduce:hover:translate-y-0 shadow-lg group",
            index % 2 === 1 ? "sm:mt-12" : ""
          ]}>
            <div class="flex items-center gap-3 mb-4">
              <div class={`h-10 w-10 rounded-full flex items-center justify-center font-bold text-xs border transition-colors ${card.badgeClass}`}>
                {card.badge}
              </div>
              <div>
                <p class="text-white font-bold text-sm leading-tight">{card.title}</p>
                <p class="text-white/70 text-[11px] font-medium mt-0.5">{card.subtitle}</p>
              </div>
            </div>
            <p class="text-white/85 text-sm leading-relaxed">
              {card.desc}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Ambient Glows - Differentiated by theme -->
  <div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/2 h-96 w-96 rounded-full bg-brand-green/10 blur-[120px] dark:bg-brand-green/20 dark:blur-[150px] transition-all duration-700"></div>
  <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 h-96 w-96 rounded-full bg-blue-500/10 blur-[120px] dark:bg-purple-500/15 dark:blur-[150px] transition-all duration-700"></div>
</section>
