---
import MainLayout from '../../layouts/MainLayout.astro';
import { blogPosts } from '../../data/blogPosts';

const title = "Blog & Dicas de Manutenção Residencial em Blumenau | Fix Serviços";
const description = "Guias práticos de eletricista, encanador e reparos residenciais para Blumenau. Dicas de segurança, manutenção preventiva e instalações pelo Técnico Osmar.";
const canonicalURL = "https://fixblu.com.br/blog/";

const schema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Blog Fix Serviços Blumenau",
  "description": description,
  "url": canonicalURL,
  "publisher": {
    "@type": "LocalBusiness",
    "name": "Fix Serviços",
    "telephone": "+55-47-98804-1306",
    "url": "https://fixblu.com.br",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Blumenau",
      "addressRegion": "SC",
      "addressCountry": "BR"
    }
  },
  "blogPost": blogPosts.map((post) => ({
    "@type": "BlogPosting",
    "headline": post.title,
    "description": post.description,
    "datePublished": post.date,
    "url": `https://fixblu.com.br/blog/${post.slug}/`,
    "author": {
      "@type": "Person",
      "name": post.author.name,
      "jobTitle": post.author.role
    }
  }))
};
---

<MainLayout title={title} description={description} canonicalURL={canonicalURL} noPadding={true} schema={schema}>
  <!-- Hero Section -->
  <section class="relative pt-32 pb-16 sm:pt-40 sm:pb-20 bg-brand-navy overflow-hidden text-white">
    <div class="absolute inset-0 bg-gradient-to-b from-brand-navy via-brand-navy to-[#050B14] opacity-90 z-0"></div>
    <div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/2 h-96 w-96 rounded-full bg-brand-green/10 blur-[120px]"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 text-center">
      <div class="inline-flex items-center gap-2 bg-brand-green/20 text-brand-green px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider mb-6 border border-brand-green/30">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path><path d="M6 6h10"></path><path d="M6 10h10"></path></svg>
        Conhecimento e Dicas Técnicas
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold font-display tracking-tight text-white mb-6 leading-tight">
        Blog da <span class="text-brand-green">Fix Serviços</span>
      </h1>
      <p class="text-base sm:text-xl text-white/80 max-w-2xl mx-auto leading-relaxed">
        Guias técnicos, dicas de segurança e soluções práticas para problemas elétricos, hidráulicos e reparos em Blumenau.
      </p>
    </div>
  </section>

  <!-- Posts Grid Section -->
  <section class="py-16 sm:py-24 bg-surface-2 transition-colors">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      
      <!-- Category Badges / Intro -->
      <div class="flex flex-wrap items-center justify-between gap-4 mb-12 pb-6 border-b border-border-main">
        <div>
          <h2 class="text-2xl font-bold font-display text-text-main">Todos os Artigos</h2>
          <p class="text-sm text-text-muted mt-1">Conteúdo original elaborado pelo Técnico Osmar</p>
        </div>
        <div class="flex flex-wrap gap-2 text-xs font-semibold">
          <span class="px-3 py-1.5 rounded-lg bg-brand-green text-white">Todos ({blogPosts.length})</span>
          <span class="px-3 py-1.5 rounded-lg bg-surface-1 border border-border-main text-text-muted">Eletricista</span>
          <span class="px-3 py-1.5 rounded-lg bg-surface-1 border border-border-main text-text-muted">Encanador</span>
          <span class="px-3 py-1.5 rounded-lg bg-surface-1 border border-border-main text-text-muted">Marido de Aluguel</span>
        </div>
      </div>

      <!-- Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {blogPosts.map((post) => (
          <article class="flex flex-col bg-surface-1 border border-border-main rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-md hover:border-brand-green/40 transition-all duration-300 group">
            <div class="flex items-center justify-between gap-2 mb-4 text-xs">
              <span class="inline-block px-2.5 py-1 rounded-md font-bold uppercase tracking-wider bg-brand-green/10 text-brand-green-text dark:text-brand-green">
                {post.category}
              </span>
              <span class="text-text-muted flex items-center gap-1.5">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                {post.readTime}
              </span>
            </div>

            <h3 class="text-xl sm:text-2xl font-bold font-display text-text-main group-hover:text-brand-green transition-colors leading-snug mb-3">
              <a href={`/blog/${post.slug}/`} class="no-underline text-inherit">
                {post.title}
              </a>
            </h3>

            <p class="text-sm sm:text-base text-text-muted leading-relaxed mb-6 flex-1">
              {post.description}
            </p>

            <div class="pt-4 border-t border-border-main flex items-center justify-between text-xs">
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-full bg-brand-navy text-white flex items-center justify-center font-bold text-xs">
                  O
                </div>
                <div>
                  <span class="font-bold text-text-main block">{post.author.name}</span>
                  <span class="text-text-muted text-[11px] block">{post.author.role}</span>
                </div>
              </div>

              <a 
                href={`/blog/${post.slug}/`} 
                class="inline-flex items-center gap-1 font-bold text-brand-green hover:underline uppercase tracking-wide no-underline group-hover:translate-x-0.5 transition-transform"
              >
                Ler mais
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Bottom Banner for Direct Service Hiring -->
      <div class="mt-16 bg-gradient-to-r from-brand-navy to-[#0F1E36] rounded-2xl p-8 sm:p-12 text-white flex flex-col md:flex-row items-center justify-between gap-6 border border-white/10 shadow-lg">
        <div class="max-w-xl text-center md:text-left">
          <span class="text-brand-green text-xs font-bold uppercase tracking-widest block mb-2">Atendimento Imediato</span>
          <h3 class="text-2xl sm:text-3xl font-bold font-display text-white mb-2">Precisa de um reparo agora em Blumenau?</h3>
          <p class="text-white/80 text-sm sm:text-base">
            Não arrisque com instalações perigosas. Fale direto com o Técnico Osmar para orçamento rápido sem compromisso.
          </p>
        </div>
        <a 
          href="https://wa.me/5547988041306?text=Ol%C3%A1!%20Li%20o%20blog%20da%20Fix%20Servi%C3%A7os%20e%20preciso%20de%20um%20or%C3%A7amento%20em%20Blumenau."
          target="_blank"
          rel="noopener noreferrer"
          class="bg-brand-green hover:bg-brand-green-hover text-white font-bold px-8 py-4 rounded-xl text-sm uppercase tracking-wider transition-all shadow-lg hover:shadow-brand-green/30 no-underline shrink-0 flex items-center gap-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l2.27-2.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          Chamar no WhatsApp
        </a>
      </div>

    </div>
  </section>
</MainLayout>
