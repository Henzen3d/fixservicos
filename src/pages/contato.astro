---
import MainLayout from '../layouts/MainLayout.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Fix Serviços",
  "description": "Eletricista, Encanador e Marido de Aluguel em Blumenau. Atendimento rápido para residências e empresas.",
  "url": "https://fixblu.com.br",
  "telephone": "+55-47-98804-1306",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Rua Germano Beduschi, 101 – Sala 102",
    "addressLocality": "Blumenau",
    "addressRegion": "SC",
    "postalCode": "89066-020",
    "addressCountry": "BR"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
      "opens": "08:00",
      "closes": "18:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Saturday",
      "opens": "08:00",
      "closes": "13:00"
    }
  ],
  "areaServed": { "@type": "City", "name": "Blumenau" }
};

const waLink = "https://wa.me/5547988041306?text=Ol%C3%A1!%20Vi%20o%20site%20e%20preciso%20de%20um%20or%C3%A7amento%20para%20um%20reparo%20em%20Blumenau.";

const faqs = [
  {
    q: "Quais regiões vocês atendem?",
    a: "Atendemos toda a cidade de Blumenau — Centro, Velha, Victor Konder, Itoupava, Vila Nova, Ponta Aguda, Garcia e demais bairros. Também atendemos municípios vizinhos conforme disponibilidade de agenda."
  },
  {
    q: "Como é feito o orçamento?",
    a: "O orçamento pode ser feito de forma rápida via WhatsApp — basta enviar fotos ou um vídeo curto do problema. Para serviços mais complexos, agendamos uma visita técnica sem custo."
  },
  {
    q: "Vocês emitem nota fiscal?",
    a: "Sim! Emitimos nota fiscal de serviços (NFS-e) para residências e empresas. Trabalhamos na formalidade para garantir sua tranquilidade."
  },
  {
    q: "Qual o prazo de atendimento?",
    a: "Em casos de urgência (curto-circuito, vazamento, etc.), tentamos atender no mesmo dia. Para serviços agendados, o prazo médio é de 24 a 48 horas."
  },
  {
    q: "Há garantia nos serviços prestados?",
    a: "Sim. Todos os nossos serviços possuem garantia. O período varia conforme o tipo de serviço e os materiais utilizados. Ao solicitar o orçamento, informamos o prazo de garantia específico."
  }
];
---

<MainLayout
  title="Contato e Perguntas Frequentes - Fix Serviços"
  description="Entre em contato com a Fix Serviços para orçamento de Eletricista, Encanador e Marido de Aluguel em Blumenau. Resposta rápida via WhatsApp."
  canonicalURL="https://fixblu.com.br/contato/"
  h1="Contato"
  schema={schema}
>
  <section class="py-14 sm:py-20 bg-surface-1 transition-colors">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">

        <!-- Left: Contact info -->
        <div>
          <span class="inline-flex items-center bg-brand-green/10 text-brand-green-text dark:text-brand-green px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide mb-4">
            Fale conosco
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold text-text-main font-display mb-4 leading-tight">
            Atendimento rápido para toda Blumenau
          </h2>
          <p class="text-text-muted text-base mb-8 leading-relaxed">
            Estamos prontos para resolver suas necessidades de manutenção e reparos. Chame no WhatsApp e receba seu orçamento em minutos.
          </p>

          <!-- Contact cards -->
          <div class="space-y-4 mb-8">
            <!-- WhatsApp -->
            <a
              href={waLink}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 p-4 bg-surface-2 border border-border-main rounded-2xl hover:border-brand-green/50 transition-all group no-underline"
            >
              <div class="flex-shrink-0 h-12 w-12 rounded-xl bg-[#25D366]/10 flex items-center justify-center text-[#25D366] group-hover:bg-[#25D366] group-hover:text-white transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.56 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9a16 16 0 0 0 6.91 6.91l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div>
                <p class="font-bold text-text-main text-sm">WhatsApp (preferencial)</p>
                <p class="text-text-muted text-sm">(47) 98804-1306 — Resposta em ~5 min</p>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-auto text-text-muted group-hover:text-brand-green transition-colors" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </a>

            <!-- Telefone -->
            <a
              href="tel:+554798804-1306"
              class="flex items-center gap-4 p-4 bg-surface-2 border border-border-main rounded-2xl hover:border-brand-green/50 transition-all group no-underline"
            >
              <div class="flex-shrink-0 h-12 w-12 rounded-xl bg-brand-green/10 flex items-center justify-center text-brand-green group-hover:bg-brand-green group-hover:text-white transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.56 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9a16 16 0 0 0 6.91 6.91l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div>
                <p class="font-bold text-text-main text-sm">Telefone</p>
                <p class="text-text-muted text-sm">(47) 98804-1306</p>
              </div>
            </a>

            <!-- Endereço -->
            <div class="flex items-start gap-4 p-4 bg-surface-2 border border-border-main rounded-2xl">
              <div class="flex-shrink-0 h-12 w-12 rounded-xl bg-brand-navy/10 dark:bg-white/10 flex items-center justify-center text-brand-navy dark:text-white">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <p class="font-bold text-text-main text-sm">Endereço</p>
                <p class="text-text-muted text-sm">Rua Germano Beduschi, 101 – Sala 102<br/>Blumenau – SC, 89066-020</p>
              </div>
            </div>

            <!-- Horário -->
            <div class="flex items-start gap-4 p-4 bg-surface-2 border border-border-main rounded-2xl">
              <div class="flex-shrink-0 h-12 w-12 rounded-xl bg-yellow-400/10 flex items-center justify-center text-yellow-600 dark:text-yellow-400">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div>
                <p class="font-bold text-text-main text-sm">Horário de Atendimento</p>
                <p class="text-text-muted text-sm">Seg–Sex: 08h às 18h<br/>Sábado: 08h às 13h</p>
              </div>
            </div>
          </div>

          <!-- Main CTA -->
          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 w-full sm:w-auto bg-brand-green hover:bg-brand-green-hover text-white font-bold py-4 px-8 rounded-2xl transition-all hover:scale-105 active:scale-95 no-underline shadow-lg shadow-brand-green/25 text-base"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            Falar agora no WhatsApp
          </a>
        </div>

        <!-- Right: Google Map + FAQ -->
        <div class="space-y-8">
          <!-- Google Maps embed -->
          <div class="rounded-2xl overflow-hidden border border-border-main shadow-soft h-64 sm:h-72">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3593.0!2d-49.0661!3d-26.9194!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94df1c8b4d7f0001%3A0xabc!2sRua+Germano+Beduschi%2C+101+-+Sala+102%2C+Blumenau+-+SC!5e0!3m2!1spt-BR!2sbr!4v1000000000000!5m2!1spt-BR!2sbr"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Localização Fix Serviços em Blumenau"
            ></iframe>
          </div>

          <!-- FAQ -->
          <div>
            <h2 class="text-xl font-bold text-text-main font-display mb-5">Perguntas Frequentes</h2>
            <div class="space-y-3" id="faq-container">
              {faqs.map((faq, i) => (
                <details class="group bg-surface-2 border border-border-main rounded-2xl overflow-hidden transition-colors" id={`faq-${i}`}>
                  <summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer list-none font-semibold text-text-main text-sm hover:text-brand-green transition-colors">
                    {faq.q}
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 transition-transform group-open:rotate-180 text-brand-green" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                  </summary>
                  <div class="px-5 pb-4 text-sm text-text-muted leading-relaxed border-t border-border-main pt-3">
                    {faq.a}
                  </div>
                </details>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
