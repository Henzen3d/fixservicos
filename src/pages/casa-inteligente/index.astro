---
import MainLayout from '../../layouts/MainLayout.astro';
import HeroServico from '../../components/HeroServico.astro';
import Marquee from '../../components/Marquee.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Reviews from '../../components/Reviews.astro';
const title = "💡 Casa Inteligente - Fix Serviços";
const description = "Tudo para sua Smart Home em Blumenau, serviços de instalação e configuração de dispositivos smart wireless para sua Casa Inteligente";
const canonicalURL = "https://fixblu.com.br/casa-inteligente/";
const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Casa Inteligente em Blumenau",
  "description": description,
  "provider": {
    "@type": "LocalBusiness",
    "name": "Fix Serviços",
    "telephone": "+55-47-98804-1306",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Rua Germano Beduschi, 101 – Sala 102",
      "addressLocality": "Blumenau",
      "addressRegion": "SC",
      "addressCountry": "BR"
    }
  },
  "areaServed": { "@type": "City", "name": "Blumenau" },
  "url": canonicalURL
};
---
<MainLayout title={title} description={description} canonicalURL={canonicalURL} noPadding={true} schema={schema}>
  <HeroServico
    badge="Smart Home & Automação"
    titulo="Casa Inteligente em Blumenau"
    subtitulo="Automação Residencial Wi-Fi"
    descricao="Instalação e configuração de dispositivos inteligentes para sua Smart Home em Blumenau. Compatível com Alexa, Google Home e Siri."
    imagemDesktop="/images/hero-bg.png"
    imagemMobile="/images/hero-mobile-optimized.jpg"
    altImagem="Casa Inteligente Blumenau - Fix Serviços"
    whatsappMsg="Olá! Vi o site e tenho interesse em automação residencial em Blumenau. Pode me passar um orçamento?"
  />
  <Marquee />

  <section class="py-16 sm:py-20 bg-surface-2 transition-colors">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">

      <!-- Section header -->
      <div class="mb-10 sm:mb-12">
        <span class="inline-flex items-center bg-brand-green/10 text-brand-green-text dark:text-brand-green px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide mb-4">
          Smart Home
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-main font-display leading-tight">
          Como podemos ajudar você hoje?
        </h2>
        <p class="mt-3 text-base text-text-muted max-w-2xl">
          Instalação e configuração de dispositivos inteligentes para automação residencial em Blumenau. Compatível com Alexa, Google Home e Apple Home.
        </p>
      </div>

      <!-- Service cards grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
        <ServiceCard
          href="/casa-inteligente/instalar-interruptor-sonoff/"
          titulo="Interruptor Sonoff"
          descricao="Controle Wi-Fi para iluminação via app ou voz."
          icone={`<path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" x2="12" y1="2" y2="12"/>`}
        />
        <ServiceCard
          href="/casa-inteligente/instalacao-interruptor-inteligente/"
          titulo="Interruptor Inteligente"
          descricao="Compatível com Alexa, Google Home e Apple Home."
          icone={`<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/><circle cx="12" cy="16" r="1"/>`}
        />
        <ServiceCard
          href="/casa-inteligente/instalacao-de-fechadura-digital/"
          titulo="Fechadura Inteligente"
          descricao="Acesso smart por aplicativo, biometria e automações."
          icone={`<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/><path d="M12 15v2"/><circle cx="12" cy="14" r="1"/>`}
        />
      </div>
    </div>
  </section>
  <Reviews />
</MainLayout>

