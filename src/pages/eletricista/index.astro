---
import MainLayout from '../../layouts/MainLayout.astro';
import HeroServico from '../../components/HeroServico.astro';
import Marquee from '../../components/Marquee.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Reviews from '../../components/Reviews.astro';
const title = "⚡ Eletricista Blumenau - Fix Serviços";
const description = "Eletricista em Blumenau especializado em reparo elétrico, curto circuito, pane elétrica e soluções residenciais e comerciais com segurança.";
const canonicalURL = "https://fixblu.com.br/eletricista/";
const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Eletricista em Blumenau",
  "description": description,
  "provider": {
    "@type": "LocalBusiness",
    "name": "Fix Serviços",
    "telephone": "+55-47-98804-1306",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Rua Germano Beduschi, 101 – Sala 102",
      "addressLocality": "Blumenau",
      "addressRegion": "SC",
      "addressCountry": "BR"
    }
  },
  "areaServed": { "@type": "City", "name": "Blumenau" },
  "url": canonicalURL
};
---
<MainLayout title={title} description={description} canonicalURL={canonicalURL} noPadding={true} schema={schema}>
  <HeroServico
    badge="Eletricista Profissional"
    titulo="Eletricista em Blumenau"
    subtitulo="Instalações e Reparos Elétricos"
    descricao="Eletricista profissional certificado NR10 para sua casa ou empresa. Instalações, trocas e manutenções elétricas com segurança e rapidez."
    imagemDesktop="/images/hero-bg.png"
    imagemMobile="/images/hero-mobile-optimized.jpg"
    altImagem="Eletricista Blumenau - Fix Serviços"
    whatsappMsg="Olá! Vi o site e preciso de um eletricista em Blumenau. Pode me passar um orçamento?"
  />
  <Marquee />

  <section class="py-16 sm:py-20 bg-surface-2 transition-colors">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">

      <!-- Section header -->
      <div class="mb-10 sm:mb-12">
        <span class="inline-flex items-center bg-brand-green/10 text-brand-green-text dark:text-brand-green px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide mb-4">
          Serviços Elétricos
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-main font-display leading-tight">
          Como podemos ajudar você hoje?
        </h2>
        <p class="mt-3 text-base text-text-muted max-w-2xl">
          Eletricista profissional certificado NR10. Atendemos residências e empresas em Blumenau com segurança e agilidade.
        </p>
      </div>

      <!-- Service cards grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
        <ServiceCard
          href="/eletricista/troca-de-lampadas/"
          titulo="Troca de Lâmpadas"
          descricao="Substituição segura em locais de difícil acesso."
          icone={`<path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1.3.5 2.6 1.5 3.5.8.8 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/>`}
        />
        <ServiceCard
          href="/eletricista/instalacao-de-luminaria/"
          titulo="Instalação de Luminária"
          descricao="Luminárias, lustres, pendentes e spots."
          icone={`<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>`}
        />
        <ServiceCard
          href="/eletricista/consertar-a-iluminacao-da-piscina/"
          titulo="Conserto Lâmpada da Piscina"
          descricao="Reparo de iluminação subaquática com segurança."
          icone={`<path d="M2 12h20"/><path d="M2 6c1.5 2 3 3 6 3s4.5-1 6-3 4.5-3 6-3"/><path d="M2 18c1.5-2 3-3 6-3s4.5 1 6 3 4.5 3 6 3"/>`}
        />
        <ServiceCard
          href="/eletricista/troca-de-resistencia-de-chuveiro-queimado/"
          titulo="Troca de Resistência"
          descricao="Chuveiro queimou? Troca rápida e segura."
          icone={`<path d="M12 2v4"/><path d="m16.24 7.76-2.83 2.83"/><path d="M21 12h-4"/><path d="m16.24 16.24-2.83-2.83"/><path d="M12 22v-4"/><path d="m7.76 16.24 2.83-2.83"/><path d="M3 12h4"/><path d="m7.76 7.76 2.83 2.83"/>`}
        />
