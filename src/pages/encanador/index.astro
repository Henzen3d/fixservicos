---
import MainLayout from '../../layouts/MainLayout.astro';
import HeroServico from '../../components/HeroServico.astro';
import Marquee from '../../components/Marquee.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Reviews from '../../components/Reviews.astro';
const title = "💦Encanador Blumenau - Fix Serviços";
const description = "Encanador para Blumenau residencial, comercial e predial. Solicite seu orçamento sem compromisso. Profissional qualificado Fix Serviços";
const canonicalURL = "https://fixblu.com.br/encanador/";
const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Encanador em Blumenau",
  "description": description,
  "provider": {
    "@type": "LocalBusiness",
    "name": "Fix Serviços",
    "telephone": "+55-47-98804-1306",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Rua Germano Beduschi, 101 – Sala 102",
      "addressLocality": "Blumenau",
      "addressRegion": "SC",
      "addressCountry": "BR"
    }
  },
  "areaServed": { "@type": "City", "name": "Blumenau" },
  "url": canonicalURL
};
---
<MainLayout title={title} description={description} canonicalURL={canonicalURL} noPadding={true} schema={schema}>
  <HeroServico
    badge="Encanador Profissional"
    titulo="Encanador em Blumenau"
    subtitulo="Reparos e Instalações Hidráulicas"
    descricao="Encanador qualificado para reparos residenciais, comerciais e prediais em Blumenau. Atendimento rápido, sem vazamentos e sem dor de cabeça."
    imagemDesktop="/images/hero-bg.png"
    imagemMobile="/images/hero-mobile-optimized.jpg"
    altImagem="Encanador Blumenau - Fix Serviços"
    whatsappMsg="Olá! Vi o site e preciso de um encanador em Blumenau. Pode me passar um orçamento?"
  />
  <Marquee />

  <section class="py-16 sm:py-20 bg-surface-2 transition-colors">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">

      <!-- Section header -->
      <div class="mb-10 sm:mb-12">
        <span class="inline-flex items-center bg-brand-green/10 text-brand-green-text dark:text-brand-green px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide mb-4">
          Serviços Hidráulicos
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-main font-display leading-tight">
          Como podemos ajudar você hoje?
        </h2>
        <p class="mt-3 text-base text-text-muted max-w-2xl">
          Encanador qualificado para toda Blumenau. Resolvemos vazamentos, instalações e reparos hidráulicos com rapidez.
        </p>
      </div>

      <!-- Service cards grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
        <ServiceCard
          href="/encanador/instalacao-de-torneira/"
          titulo="Instalação de Torneira"
          descricao="Troca e instalação de torneiras de cozinha e banheiro."
          icone={`<path d="M14 11a2 2 0 1 1-4 0 4 4 0 0 1 4-4h1a6 6 0 0 1 6 6v1a2 2 0 0 1-2 2h-1"/><path d="M6 11V9a6 6 0 0 1 6-6"/><path d="M6 11H4a2 2 0 0 0-2 2v1a2 2 0 0 0 2 2h0a2 2 0 0 0 2-2v-3z"/><line x1="10" x2="10" y1="22" y2="11"/>`}
        />
        <ServiceCard
          href="/encanador/instalacao-de-torneira-eletrica/"
          titulo="Torneira Elétrica"
          descricao="Instalação de aquecimento instantâneo de água."
          icone={`<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>`}
        />
        <ServiceCard
          href="/encanador/conserto-de-descarga-em-caixa-acoplada/"
          titulo="Conserto Caixa Acoplada"
          descricao="Reparo de vazamentos em vasos sanitários."
          icone={`<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" x2="21" y1="6" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>`}
        />
        <ServiceCard
          href="/encanador/reparo-valvula-descarga-hydra-docol/"
          titulo="Válvula Hydra / Docol"
          descricao="Reparo e troca de válvulas de descarga."
          icone={`<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>`}
        />
        <ServiceCard
          href="/encanador/troca-de-sifao/"
          titulo="Troca de Sifão"
          descricao="Eliminação de mau cheiro nas pias e ralos."
          icone={`<path d="M12 2v4"/><path d="M12 18v4"/><path d="M4.93 4.93l2.83 2.83"/><path d="M16.24 16.24l2.83 2.83"/><path d="M2 12h4"/><path d="M18 12h4"/><path d="M4.93 19.07l2.83-2.83"/><path d="M16.24 7.76l2.83-2.83"/>`}
        />
        <ServiceCard
          href="/encanador/troca-ralo-de-pia/"
          titulo="Troca de Ralo de Pia"
          descricao="Instalação de válvula e ralo para pias."
          icone={`<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/>`}
        />
      </div>
    </div>
  </section>
  <Reviews />
</MainLayout>

