---
import MainLayout from '../../layouts/MainLayout.astro';
import HeroServico from '../../components/HeroServico.astro';
import Marquee from '../../components/Marquee.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Reviews from '../../components/Reviews.astro';

const title = "🔨 Serviços para Blumenau - Fix Serviços";
const description = "A Fix Serviços oferece para Blumenau diversos serviços: Eletricista, Encanador, Marido de Aluguel e Casa Inteligente. Solicite orçamento agora!";
const canonicalURL = "https://fixblu.com.br/servicos/";

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Fix Serviços",
  "description": description,
  "telephone": "+55-47-98804-1306",
  "url": "https://fixblu.com.br",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Rua Germano Beduschi, 101 – Sala 102",
    "addressLocality": "Blumenau",
    "addressRegion": "SC",
    "postalCode": "89066-020",
    "addressCountry": "BR"
  },
  "areaServed": { "@type": "City", "name": "Blumenau" },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Serviços Fix Blumenau",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Eletricista em Blumenau" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Encanador em Blumenau" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Marido de Aluguel em Blumenau" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Casa Inteligente em Blumenau" } }
    ]
  }
};
---

<MainLayout title={title} description={description} canonicalURL={canonicalURL} noPadding={true} schema={schema}>
  <HeroServico
    badge="Todos os Serviços"
    titulo="Serviços em Blumenau"
    subtitulo="Eletricista · Encanador · Marido de Aluguel"
    descricao="Tudo que você precisa para sua casa ou empresa em Blumenau. Profissionais qualificados, atendimento rápido e orçamento sem compromisso."
    imagemDesktop="/images/hero-bg.png"
    imagemMobile="/images/hero-mobile-optimized.jpg"
    altImagem="Serviços em Blumenau - Fix Serviços"
    whatsappMsg="Olá! Vi o site e preciso de um orçamento para um serviço em Blumenau. Pode me ajudar?"
  />
  <Marquee />

  <section class="py-16 sm:py-20 bg-surface-2 transition-colors">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">

      <div class="mb-10 sm:mb-12 text-center">
        <span class="inline-flex items-center bg-brand-green/10 text-brand-green-text dark:text-brand-green px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wide mb-4">
          O que fazemos
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-text-main font-display leading-tight">
          Nossas categorias de serviço
        </h2>
        <p class="mt-3 text-base text-text-muted max-w-2xl mx-auto">
          Escolha a categoria do seu problema e veja os serviços disponíveis em Blumenau.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        <ServiceCard
          href="/eletricista/"
          titulo="Eletricista"
          descricao="Instalações elétricas, trocas e reparos seguros certificados NR10."
          icone={`<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>`}
        />
        <ServiceCard
          href="/encanador/"
          titulo="Encanador"
          descricao="Vazamentos, torneiras, descargas e instalações hidráulicas."
          icone={`<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>`}
        />
        <ServiceCard
          href="/marido-de-aluguel/"
          titulo="Marido de Aluguel"
          descricao="TVs, persianas, quadros, fechaduras, montagens e pequenos reparos."
          icone={`<path d="m15 12-8.5 8.5c-.83.83-2.17.83-3 0 0 0 0 0 0 0a2.12 2.12 0 0 1 0-3L12 9"/><path d="M17.64 15 22 10.64"/><path d="m20.91 11.7-1.25-1.25c-.6-.6-.93-1.4-.93-2.25v-.86c0-1 1.92-1.92 1.92-1.92s.51-.51.51-1.46A2.25 2.25 0 0 0 17.91 1.7c-.95 0-1.46.51-1.46.51s-.92 1.92-1.92 1.92h-.86c-.85 0-1.65.33-2.25.93l-1.25 1.25"/>`}
        />
        <ServiceCard
          href="/casa-inteligente/"
          titulo="Casa Inteligente"
          descricao="Automação Wi-Fi, interruptores smart, Alexa e Google Home."
          icone={`<path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A5 5 0 0 0 8 8c0 1.3.5 2.6 1.5 3.5.8.8 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/>`}
        />
      </div>
    </div>
  </section>

  <Reviews />
</MainLayout>
